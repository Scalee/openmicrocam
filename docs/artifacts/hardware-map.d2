      p4: "4" {class: idle; tooltip: "**DISP port** · layer 0, port 4\n\nOurs: unused — the pictures lie in the canvas [R] ‖ **Порт DISP** · слой 0, порт 4\n\nУ нас: не используем — картинки лежат в холсте [R]"}
      p5: "5" {class: idle; tooltip: "**DISP port** · layer 0, port 5\n\nOurs: unused — the pictures lie in the canvas [R] ‖ **Порт DISP** · слой 0, порт 5\n\nУ нас: не используем — картинки лежат в холсте [R]"}
      p6: "6" {class: idle; tooltip: "**DISP port** · layer 0, port 6\n\nOurs: unused — the pictures lie in the canvas [R] ‖ **Порт DISP** · слой 0, порт 6\n\nУ нас: не используем — картинки лежат в холсте [R]"}
      p7: "7" {class: idle; tooltip: "**DISP port** · layer 0, port 7\n\nOurs: unused — the pictures lie in the canvas [R] ‖ **Порт DISP** · слой 0, порт 7\n\nУ нас: не используем — картинки лежат в холсте [R]"}
      p8: "8" {class: idle; tooltip: "**DISP port** · layer 0, port 8\n\nOurs: unused — the pictures lie in the canvas [R] ‖ **Порт DISP** · слой 0, порт 8\n\nУ нас: не используем — картинки лежат в холсте [R]"}
