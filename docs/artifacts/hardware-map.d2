  class: pool
  top: 1530
  left: 0
  grid-rows: 1
  grid-gap: 2
  tooltip: "**Pool** · Linux RAM — the memory of the processes and the kernel\n\nLimits: 74.3 MB (MemTotal) [R]\n\nOurs: 20.8 MB available in the same measurement, microcamd resident 26.1; the tile layers' budget `LAYER_BYTES` 12 MiB [R] ‖ **Пул** · Linux RAM — память процессов и ядра\n\nПределы: 74,3 МБ (MemTotal) [R]\n\nУ нас: в том же замере доступно 20,8 МБ, microcamd в памяти 26,1; бюджет слоёв тайла `LAYER_BYTES` 12 МиБ [R]"
  used: "used · 53.5 ‖ занято · 53,5" {class: memused; width: 508; height: 40; tooltip: "**Used** · about 53.5 MB: processes and kernel (74.3 − 20.8 available), microcamd 26.1 of it ‖ **Занято** · около 53,5 МБ: процессы и ядро (74,3 − доступные 20,8), из них microcamd 26,1"}
  free: "available 20.8 ‖ доступно 20,8" {class: memfree; width: 198; height: 40; tooltip: "**Available** · 20.8 MB (MemAvailable) in this measurement [R] ‖ **Доступно** · 20,8 МБ (MemAvailable) в этом замере [R]"}
}

